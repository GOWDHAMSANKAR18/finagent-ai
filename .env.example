# FinAgent AI — Environment Configuration

# Provider Choice: 'groq' (Free Developer Tier), 'gemini' (Free Tier), 'ollama' (Local Model), or 'local' (Offline Deterministic Fallback)
LLM_PROVIDER=groq

# Free Tier API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Name (e.g. qwen/qwen3.8-27b, openai/gpt-oss-20b, llama-3.3-70b-versatile, gemini-1.5-flash)
LLM_MODEL=qwen/qwen3.8-27b

# Hyperparameters
LLM_TIMEOUT=15
LLM_RETRY_LIMIT=2
LLM_MAX_TOKENS=2048

# Ollama local endpoint configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# External Financial Data Key (Optional)
FINANCIAL_API_KEY=

# Server Config
HOST=127.0.0.1
PORT=8000
DEBUG=True
